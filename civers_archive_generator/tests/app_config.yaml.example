# Archive Generator Test Configuration Example
# This file is used for testing purposes

app:
  name: archive_generator
  version: 1.0.0
  archive_directory: archives

  # Scoop settings (for testing)
  scoop_cli_command: "node lib/scoop/bin/cli.js"
  scoop_timeout_sec: 300
  scoop_extra_args: ["--screenshot", "true", "--dom-snapshot", "true", "--log-level", "info", "--proxy-port", "0"]

  transport:
    enabled: ["kafka"]
    kafka:
      bootstrap_servers: localhost:29092
      topics:
        archive_requests: "archive.requests"
        archive_status: "archive.status"
        archive_completed: "archive.completed"
        archive_failed: "archive.failed"
      consumer_group: "archive_generator_group"
      health_check_enabled: true
      monitoring_enabled: true

  storage:
    backend: local_file
    backends:
      local_file:
        base_path: archives

domains:
  - name: example.com
    artifacts: [warc, html]
    webpage_types: dynamic
    
  - name: arachne.dainst.org
    artifacts:
      - warc
      - html
      - screenshots
    webpage_types: dynamic
    
  - name: field.dainst.org
    artifacts:
      - warc
      - html
    webpage_types: dynamic