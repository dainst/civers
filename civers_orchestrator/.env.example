# ==============================================================================
# CiVers Orchestrator - Environment Variables Configuration
# ==============================================================================
#
# This file documents all environment variables used by the orchestrator.
# Copy this file to `.env` and modify values as needed.
#
# Usage:
#   - Docker Compose: Variables are automatically loaded from .env
#   - Local development: export VAR=value or use direnv
#   - Command line: VAR=value uv run python main.py
#
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------

# Environment name: development | testing | docker | e2e | production
# This determines which YAML config file is loaded from configs/data/environments/
CONFIG_ENVIRONMENT=docker

# Application metadata
APP_NAME=civers_orchestrator
APP_VERSION=1.0.0

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# KAFKA BROKER CONFIGURATION
# Used by docker-compose.yml for the Kafka broker service
# ------------------------------------------------------------------------------

# Kafka node configuration
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller

# Kafka listener configuration
# Internal: for container-to-container communication
# External: for host machine access (development)
KAFKA_LISTENERS=PLAINTEXT_INTERNAL://0.0.0.0:9092,PLAINTEXT_EXTERNAL://0.0.0.0:29092,CONTROLLER://0.0.0.0:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT_INTERNAL://kafka:9092,PLAINTEXT_EXTERNAL://localhost:29092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT_INTERNAL:PLAINTEXT,PLAINTEXT_EXTERNAL:PLAINTEXT,CONTROLLER:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT_INTERNAL
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_CONTROLLER_QUORUM_VOTERS=1@localhost:9093

# Kafka replication settings (set to 1 for single-node development)
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1

# Kafka performance settings
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_NUM_PARTITIONS=3

# Kafka retention settings
KAFKA_LOG_RETENTION_HOURS=24
KAFKA_LOG_RETENTION_BYTES=1073741824

# ------------------------------------------------------------------------------
# KAFKA TRANSPORT CONFIGURATION (Application)
# Used by the orchestrator app to connect to Kafka
# ------------------------------------------------------------------------------

# Kafka bootstrap servers
# - For Docker: kafka:9092 (internal network)
# - For local development: localhost:29092 (external port)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Consumer configuration
KAFKA_CONSUMER_GROUP_ID=civers_orchestrator
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest

# Producer configuration
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=3

# ------------------------------------------------------------------------------
# KAFKA TOPICS CONFIGURATION
# Topic names used by the orchestrator
# ------------------------------------------------------------------------------

# Orchestrator topics
KAFKA_TOPIC_ORCHESTRATOR_REQUESTS=orchestrator.requests
KAFKA_TOPIC_ORCHESTRATOR_STATUS=orchestrator.status
KAFKA_TOPIC_ORCHESTRATOR_COMPLETED=orchestrator.completed
KAFKA_TOPIC_ORCHESTRATOR_FAILED=orchestrator.failed

# Archive generator component topics
KAFKA_TOPIC_ARCHIVE_REQUESTS=archive.requests
KAFKA_TOPIC_ARCHIVE_COMPLETED=archive.completed
KAFKA_TOPIC_ARCHIVE_FAILED=archive.failed

# Metadata extractor component topics
KAFKA_TOPIC_METADATA_REQUESTS=metadata.requests
KAFKA_TOPIC_METADATA_COMPLETED=metadata.completed
KAFKA_TOPIC_METADATA_FAILED=metadata.failed

# DOI service component topics
KAFKA_TOPIC_DOI_REQUESTS=doi.requests
KAFKA_TOPIC_DOI_COMPLETED=doi.completed
KAFKA_TOPIC_DOI_FAILED=doi.failed



# ------------------------------------------------------------------------------
# KAFKA UI CONFIGURATION
# Settings for the Kafka UI web interface
# ------------------------------------------------------------------------------

KAFKA_UI_CLUSTER_NAME=CiVers Kafka Cluster
KAFKA_UI_BOOTSTRAP_SERVERS=kafka:9092

# ------------------------------------------------------------------------------
# SERVICE PORTS
# Exposed ports for services
# ------------------------------------------------------------------------------

# Kafka ports
KAFKA_INTERNAL_PORT=9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=9093

# Kafka UI port
KAFKA_UI_PORT=8088

# ==============================================================================
# ENVIRONMENT PRESETS
# ==============================================================================
#
# DEVELOPMENT (local machine, no Docker):
#   CONFIG_ENVIRONMENT=development
#   KAFKA_BOOTSTRAP_SERVERS=localhost:29092
#   KAFKA_CONSUMER_GROUP_ID=civers_orchestrator
#
# DOCKER (running inside Docker network):
#   CONFIG_ENVIRONMENT=docker
#   KAFKA_BOOTSTRAP_SERVERS=kafka:9092
#   KAFKA_CONSUMER_GROUP_ID=civers_orchestrator_docker
#
# E2E TESTING:
#   CONFIG_ENVIRONMENT=e2e
#   KAFKA_BOOTSTRAP_SERVERS=localhost:29092
#   KAFKA_CONSUMER_GROUP_ID=civers_orchestrator_e2e
#
# PRODUCTION:
#   CONFIG_ENVIRONMENT=production
#   KAFKA_BOOTSTRAP_SERVERS=<your-kafka-cluster>:9092
#   KAFKA_CONSUMER_GROUP_ID=civers_orchestrator_prod
#
# ==============================================================================
