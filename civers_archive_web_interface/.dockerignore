# Docker ignore file for Civers Archive Web Interface
# Optimize build context size by excluding unnecessary files

# Python cache and virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Git
.git/
.gitignore

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Logs
*.log
logs/
.logs/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
.tmp/
.temp/

# Documentation that's not needed at runtime
README.md
*.md
docs/

# Docker files (don't include Dockerfile in itself)
Dockerfile*
docker-compose*.yml
.dockerignore

# Development tools
.pre-commit-config.yaml
.mypy_cache/
.dmypy.json
dmypy.json

# Node.js (if any frontend tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Development configuration
.env.example
.env.local
.env.development

# Claude development files
claude/
.claude

# Playwright cache
.playwright-mcp/

# Test data and development archives (exclude large test files)
test_data/
# Note: Keep archives/ as it may contain real data needed at runtime