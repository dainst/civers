# ==============================================================================
# CiVers Orchestrator - Production Environment Variables
# ==============================================================================
#
# This file is for production deployments (Kubernetes, Docker Swarm, etc.)
# Copy to .env.production and modify with your production values.
#
# IMPORTANT: Never commit this file with real production secrets!
#
# Usage:
#   docker compose --env-file .env.production up -d
#
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
CONFIG_ENVIRONMENT=production
APP_NAME=civers_orchestrator
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# KAFKA BROKER CONFIGURATION (for Kafka container if self-hosted)
# ------------------------------------------------------------------------------
# These are only needed if running Kafka as part of your deployment
# For managed Kafka (Confluent, AWS MSK, etc.), skip this section

KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_LISTENERS=PLAINTEXT_INTERNAL://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT_INTERNAL://kafka:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT_INTERNAL:PLAINTEXT,CONTROLLER:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT_INTERNAL
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_CONTROLLER_QUORUM_VOTERS=1@localhost:9093

# Production replication settings (adjust for your cluster size)
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=3
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=3
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=2
KAFKA_NUM_PARTITIONS=6

# Retention settings
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_LOG_RETENTION_BYTES=10737418240

# ------------------------------------------------------------------------------
# KAFKA TRANSPORT CONFIGURATION (Application)
# REQUIRED: Set your production Kafka cluster address
# ------------------------------------------------------------------------------

# REQUIRED - Your production Kafka cluster
KAFKA_BOOTSTRAP_SERVERS=kafka.production.example.com:9092

# Consumer configuration
KAFKA_CONSUMER_GROUP_ID=civers_orchestrator_prod
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest

# Producer configuration (higher retries for production)
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=5

# ------------------------------------------------------------------------------
# KAFKA TOPICS CONFIGURATION
# Prefix with environment if using shared cluster
# ------------------------------------------------------------------------------

KAFKA_TOPIC_ORCHESTRATOR_REQUESTS=prod.orchestrator.requests
KAFKA_TOPIC_ORCHESTRATOR_STATUS=prod.orchestrator.status
KAFKA_TOPIC_ORCHESTRATOR_COMPLETED=prod.orchestrator.completed
KAFKA_TOPIC_ORCHESTRATOR_FAILED=prod.orchestrator.failed
KAFKA_TOPIC_ARCHIVE_REQUESTS=prod.archive.requests
KAFKA_TOPIC_ARCHIVE_COMPLETED=prod.archive.completed
KAFKA_TOPIC_ARCHIVE_FAILED=prod.archive.failed
KAFKA_TOPIC_METADATA_REQUESTS=prod.metadata.requests
KAFKA_TOPIC_METADATA_COMPLETED=prod.metadata.completed
KAFKA_TOPIC_METADATA_FAILED=prod.metadata.failed
KAFKA_TOPIC_DOI_REQUESTS=prod.doi.requests
KAFKA_TOPIC_DOI_COMPLETED=prod.doi.completed
KAFKA_TOPIC_DOI_FAILED=prod.doi.failed

# ------------------------------------------------------------------------------
# MONITORING (if applicable)
# ------------------------------------------------------------------------------
# METRICS_ENABLED=true
# METRICS_PORT=9090

# ------------------------------------------------------------------------------
# SECURITY (if applicable)
# ------------------------------------------------------------------------------
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=your-username
# KAFKA_SASL_PASSWORD=your-password
