# Archive Generator Configuration Example
# Copy this file to app_config.yaml and modify as needed

app:
  name: archive_generator
  version: 1.0.0
  archive_directory: archives

  # Scoop settings (for web archiving)
  scoop_cli_command: "node lib/scoop/bin/cli.js"  # Command to invoke Scoop CLI
  scoop_timeout_sec: 300  # Timeout for Scoop process in seconds
  scoop_extra_args: ["--screenshot", "true", "--dom-snapshot", "true", "--log-level", "info", "--proxy-port", "0"]  # Additional CLI arguments

  transport:
    enabled: ["kafka"]
    kafka:
      bootstrap_servers: localhost:9092
      topics:
        archive_requests: "archive.requests"
        archive_status: "archive.status"
        archive_completed: "archive.completed"
        archive_failed: "archive.failed"
      consumer_group: "archive_generator_group"
      health_check_enabled: true
      monitoring_enabled: true

  # Storage Configuration
  # ---------------------
  # Multi-backend storage: Archives can be stored to multiple backends simultaneously.
  # Use 'enabled' list to specify which backends to use.
  # If 'enabled' is not set, falls back to single 'backend' field (legacy mode).
  storage:
    # Multi-backend mode: enable multiple storage backends
    enabled:
      - local_file
      # - civers_rest_api  # Uncomment to enable CIVERS API storage
    
    # Legacy single-backend mode (used if 'enabled' is not set)
    backend: local_file
    
    # Backend-specific configurations
    backends:
      # Local file storage (always available)
      local_file:
        base_path: "archives/metadata"
        create_subdirectories: true
      
      # CIVERS REST API storage (optional, for remote storage)
      civers_rest_api:
        upload_url: "http://localhost:8000/api/upload"
        timeout_seconds: 30
        retry_attempts: 3
        verify_ssl: true
        auth:
          enabled: false
          # type: "bearer"  # Options: "bearer" or "api_key"
          # token: "your-token-here"

domains:
  - name: example.com
    artifacts: [warc, html]
    webpage_types: dynamic
  - name: arachne.dainst.org
    artifacts: [warc, html, screenshots]
    webpage_types: dynamic
  - name: httpbin.org
    artifacts: [warc, html, screenshots]
    webpage_types: dynamic
    
  - name: arachne.dainst.org
    artifacts:
      - warc
      - html
      - screenshots
    webpage_types: dynamic
    
  - name: field.dainst.org
    artifacts:
      - warc
      - html
    webpage_types: dynamic